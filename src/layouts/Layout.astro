---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Contrapesos de plomo de alta precisión para balanceo automotor. Fabricación y venta mayorista para gomerías, talleres y distribuidores en toda Argentina."
    />
    <meta
      name="keywords"
      content="contrapesos de plomo, balanceo automotor, gomerías, talleres, venta mayorista, plomo antimonioso, Argentina, TC Contrapesos"
    />
    <meta name="author" content="TC Contrapesos" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#262626" />

    <!-- Open Graph SEO -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Especialistas en contrapesos de plomo para balanceo automotor. Catálogo estandarizado, máxima precisión y stock real. Distribuimos a gomerías y talleres de todo el país."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://contrapesostc.com.ar/" />
    <meta
      property="og:image"
      content="/contrapeso-universal.png"
    />
    <meta property="og:site_name" content="TC Contrapesos" />

    <!-- Twitter Cards SEO -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="Fábrica de contrapesos de plomo para automotores. Garantizamos calidad original, peso exacto y agarre seguro."
    />
    <meta
      name="twitter:image"
      content="/contrapeso-universal.png"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/logo-tc-icon.svg"
    />
    <link rel="canonical" href="https://contrapesostc.com.ar/" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Schema.org / Datos Estructurados -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "TC Contrapesos",
        "image": "/logo-tc-icon.svg",
        "email": "tccontrapesos@gmail.com",
        "telephone": "+54 9 11 2836-6767",
        "url": "https://contrapesostc.com.ar/",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Cnel. Molinedo 2939",
          "addressLocality": "Lanús",
          "addressRegion": "Provincia de Buenos Aires",
          "postalCode": "B1824 FZS",
          "addressCountry": "AR"
        },
        "description": "Fábrica y distribuidora mayorista especializada en contrapesos de plomo para balanceo de todo tipo de llantas de automóviles y camionetas.",
        "priceRange": "$$"
      }
    </script>

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS via CDN for rapid prototyping -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Montserrat", "sans-serif"],
            },
            colors: {
              brand: {
                dark: "#262626", // Neutral dark (Neutral 800) for high contrast and modern look
                primary: "#EF8E21", // Catalog Orange
                primaryHover: "#D37727", // Darker Catalog Orange for hover
                accent: "#3B82F6", // Light Blue (Blue 500)
                light: "#FEF6EE", // Very soft tint of catalog orange for backgrounds
              },
            },
          },
        },
      };
    </script>

    <!-- Theme Detect Script for Favicon -->
    <script is:inline>
      function updateFavicon() {
        const isDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const favicon = document.querySelector('link[rel="icon"]');
        if (favicon) {
          const baseUrl = favicon.href.substring(
            0,
            favicon.href.lastIndexOf("/"),
          );
          favicon.href = isDark
            ? `${baseUrl}/logo-tc-icon-white.svg`
            : `${baseUrl}/logo-tc-icon.svg`;
        }
      }

      updateFavicon();
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateFavicon);
    </script>
  </head>
  <body
    class="font-sans text-gray-800 bg-white antialiased selection:bg-brand-primary selection:text-white"
  >
    <slot />
  </body>
</html>

<style is:global>
  /** Smooth scrolling para los anchor links */
  html {
    scroll-behavior: smooth;
  }

  /** Ajuste de padding si el header es fijo */
  section[id] {
    scroll-margin-top: 5rem;
  }
</style>
